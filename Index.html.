const defaults = {
  xp:0, unlocked:1, world:1, phase:1,
  hero:"akira", owned:["akira"], completed:[], achievements:[]
};

let data;
try {
  const saved=localStorage.getItem("geoDadosNovo");
  data=saved?{...defaults,...JSON.parse(saved)}:{...defaults};
} catch(e) {
  data={...defaults};
}

if (!Array.isArray(data.owned)) data.owned=["akira"];
if (!Array.isArray(data.completed)) data.completed=[];
if (!Array.isArray(data.achievements)) data.achievements=[];

let currentQuestions=[];
let currentIndex=0;
let score=0;
let answered=false;
let currentWorld=1;
let currentPhase=1;

function save() {
  try { localStorage.setItem("geoDadosNovo",JSON.stringify(data)); }
  catch(e) { console.warn("Não foi possível salvar o progresso."); }
}

function level() {
  return Math.floor(data.xp/200)+1;
}

function stageNumber(world,phase) {
  return (world-1)*5+phase;
}

function isUnlocked(world,phase) {
  return stageNumber(world,phase)<=data.unlocked;
}

function isDone(world,phase) {
  return data.completed.includes(stageNumber(world,phase));
}

function showPage(id) {
