  if (id==="home") renderHome();
  if (id==="map") renderMap();
  if (id==="heroes") renderHeroes();
  if (id==="achievements") renderAchievements();
  window.scrollTo(0,0);
}

function renderAll() {
  document.getElementById("xpDisplay").textContent=data.xp;
  renderHome();
  renderMap();
  renderHeroes();
  renderAchievements();
}

function renderHome() {
  document.getElementById("xpDisplay").textContent=data.xp;
  document.getElementById("homeLevel").textContent=level();
  document.getElementById("homeWorlds").textContent=
    Math.min(worlds.length,Math.max(1,Math.ceil(data.unlocked/5)));
  document.getElementById("homeWins").textContent=data.completed.length;
}

function renderMap() {
  const container=document.getElementById("worldList");
  container.innerHTML="";

  worlds.forEach((world,i)=>{
    const num=i+1;
    const unlocked=isUnlocked(num,1);
    const completed=data.completed.filter(n=>n>=stageNumber(num,1)&&n<stageNumber(num,1)+5).length;
    const card=document.createElement("div");
    card.className="card"+(unlocked?"":" locked");
    card.innerHTML=`
      <div class="world-icon">${world.icon}</div>
      <h3>${num}. ${world.name}</h3>
      <p>${world.desc}</p>
      <div class="progress"><div style="width:${completed*20}%"></div></div>
      <p>${completed}/5 fases concluídas</p>
      <button class="btn ${unlocked?"":"secondary"}" ${unlocked?"":"disabled"}
        onclick="openWorld(${num})">${unlocked?"Explorar":"🔒 Bloqueado"}</button>`;
    container.appendChild(card);
  });
}

function openWorld(num) {
  if (!isUnlocked(num,1)) return;
  const world=worlds[num-1];
  const container=document.getElementById("worldList");
  container.innerHTML=`
    <div class="card" style="grid-column:1/-1">
      <div class="world-icon">${world.icon}</div>
      <h2>${world.name}</h2><p>${world.desc}</p>
      <p>Escolha uma fase:</p>
      <div id="phaseList" class="grid"></div>
      <button class="btn secondary" onclick="renderMap()">← Todos os mundos</button>
    </div>`;
  const phases=document.getElementById("phaseList");

  for (let phase=1;phase<=5;phase++) {
    const unlocked=isUnlocked(num,phase);
    const done=isDone(num,phase);
    const card=document.createElement("div");
    card.className="card"+(unlocked?"":" locked");
    card.innerHTML=`
      <h3>Fase ${phase}</h3>
      <p>${done?"✅ Concluída":unlocked?"Disponível":"🔒 Bloqueada"}</p>
      <button class="btn ${unlocked?"":"secondary"}" ${unlocked?"":"disabled"}
        onclick="startRound(${num},${phase})">${done?"Jogar novamente":unlocked?"Jogar":"Bloqueada"}</button>`;
    phases.appendChild(card);
  }
}

function renderHeroes() {
  const container=document.getElementById("heroList");
  container.innerHTML="";

  heroes.forEach(hero=>{
    const owned=data.owned.includes(hero.id);
    const selected=data.hero===hero.id;
    const card=document.createElement("div");
    card.className="card";
    card.innerHTML=`
      <div class="ninja">${hero.icon}</div>
      <h3>${hero.name}</h3><p>${hero.desc}</p>
      <p class="gold">${hero.cost===0?"Grátis":"⚡ "+hero.cost+" XP"}</p>
      <button class="btn ${selected?"secondary":""}" ${selected?"disabled":""}
        onclick="selectHero('${hero.id}')">
        ${selected?"Selecionado":owned?"Selecionar":data.xp>=hero.cost?"Desbloquear":"XP insuficiente"}
      </button>`;
    if (!owned && data.xp<hero.cost) card.querySelector("button").disabled=true;
    container.appendChild(card);
  });
}

function selectHero(id) {
  const hero=heroes.find(h=>h.id===id);
  if (!hero) return;

  if (!data.owned.includes(id)) {
    if (data.xp<hero.cost) return;
    data.xp-=hero.cost;
    data.owned.push(id);
  }

  data.hero=id;
  save();
  renderAll();
}

function continueGame() {
  const stage=Math.min(data.unlocked,worlds.length*5);
  const world=Math.floor((stage-1)/5)+1;
  const phase=(stage-1)%5+1;
  startRound(world,phase);
}

function startRound(world,phase) {
  if (!isUnlocked(world,phase)) {
    alert("Essa fase ainda está bloqueada!");
    return;
  }

  currentWorld=world;
  currentPhase=phase;
  currentIndex=0;
  score=0;
  answered=false;

  const pool=questions.filter(q=>q.w===world-1);
  currentQuestions=[];

  for (let i=0;i<10;i++) {
    currentQuestions.push(pool[(i*7+phase-1)%pool.length]);
  }

  currentQuestions.sort(()=>Math.random()-.5);
  document.getElementById("gameWorld").textContent=
    worlds[world-1].icon+" "+worlds[world-1].name+" • Fase "+phase;
  document.getElementById("gameNinja").textContent=
    heroes.find(h=>h.id===data.hero)?.icon||"🥷";

  showPage("game");
  renderQuestion();
}

function renderQuestion() {
  answered=false;
  const q=currentQuestions[currentIndex];

  document.getElementById("questionCount").textContent=
    "Pergunta "+(currentIndex+1)+"/10";
  document.getElementById("questionProgress").style.width=
    (currentIndex/10*100)+"%";
  document.getElementById("questionText").textContent=q.q;
  document.getElementById("feedback").textContent="";
  document.getElementById("nextBtn").hidden=true;

  const container=document.getElementById("answers");
  container.innerHTML="";

  q.a.forEach((answer,index)=>{
    const btn=document.createElement("button");
    btn.className="answer";
    btn.textContent=String.fromCharCode(65+index)+") "+answer;
    btn.onclick=()=>chooseAnswer(index);
    container.appendChild(btn);
  });
}

function chooseAnswer(index) {
  if (answered) return;
  answered=true;
  const q=currentQuestions[currentIndex];
  const buttons=document.querySelectorAll("#answers .answer");

  buttons.forEach((btn,i)=>{
    btn.disabled=true;
    if (i===q.c) btn.classList.add("correct");
  });

  const feedback=document.getElementById("feedback");

  if (index===q.c) {
    score++;
    feedback.textContent="✅ Resposta correta!";
    feedback.style.color="var(--mint)";
  } else {
    buttons[index].classList.add("wrong");
    feedback.textContent="❌ Resposta correta: "+q.a[q.c];
    feedback.style.color="var(--red)";
  }

  document.getElementById("questionProgress").style.width=
    ((currentIndex+1)/10*100)+"%";
  document.getElementById("nextBtn").hidden=false;
  document.getElementById("nextBtn").textContent=
    currentIndex===9?"Ver resultado 🏆":"Próxima pergunta →";
}

function nextQuestion() {
  if (!answered) return;
  currentIndex++;
  if (currentIndex<10) renderQuestion();
  else finishRound();
}

function finishRound() {
  const won=score>=7;
  let gainedXP=0;

  if (won) {
    gainedXP=score*10+50;
    data.xp+=gainedXP;
    const stage=stageNumber(currentWorld,currentPhase);
    if (!data.completed.includes(stage)) data.completed.push(stage);
    data.unlocked=Math.max(data.unlocked,Math.min(stage+1,worlds.length*5));

    if (score===10) unlockAchievement("perfeito");
    unlockAchievement("primeira");
    if (data.completed.length>=5) unlockAchievement("cinco");
    if (data.completed.length>=10) unlockAchievement("dez");
    if (data.xp>=500) unlockAchievement("xp500");
  }

  save();
  renderAll();

  document.getElementById("resultIcon").textContent=won?"🏆":"💪";
  document.getElementById("resultTitle").textContent=won?"Fase concluída!":"Quase lá!";
  document.getElementById("resultText").textContent=won?
    "Parabéns! Você venceu e avançou na aventura.":
    "Você precisa acertar pelo menos 7 perguntas. Tente novamente!";
  document.getElementById("resultScore").textContent=score+"/10";
  document.getElementById("resultXP").textContent="+"+gainedXP;
  document.getElementById("resultLevel").textContent=level();

  const btn=document.getElementById("resultMainBtn");
  btn.textContent=won?"Próxima fase →":"Tentar novamente";
  btn.onclick=won?continueAfterWin:()=>startRound(currentWorld,currentPhase);

  showPage("result");
}

function continueAfterWin() {
  if (currentPhase<5) startRound(currentWorld,currentPhase+1);
  else if (currentWorld<worlds.length) startRound(currentWorld+1,1);
  else showPage("map");
}

function leaveGame() {
  if (confirm("Sair desta fase? Seu resultado atual não será contado.")) showPage("map");
}

const achievementDefinitions=[
  {id:"primeira",icon:"🌟",name:"Primeira vitória",desc:"Conclua sua primeira fase."},
  {id:"perfeito",icon:"🎯",name:"Perfeição",desc:"Acerte as dez perguntas de uma fase."},
  {id:"cinco",icon:"🗺️",name:"Explorador",desc:"Conclua cinco fases."},
  {id:"dez",icon:"🌎",name:"Viajante mundial",desc:"Conclua dez fases."},
  {id:"xp500",icon:"⚡",name:"Mestre da experiência",desc:"Acumule 500 XP."}
];

function unlockAchievement(id) {
  if (!data.achievements.includes(id)) data.achievements.push(id);
}

function renderAchievements() {
  const container=document.getElementById("achievementList");
  if (!container) return;
  container.innerHTML="";

  achievementDefinitions.forEach(item=>{
    const unlocked=data.achievements.includes(item.id);
    const card=document.createElement("div");
    card.className="card";
    card.style.marginBottom="10px";
    card.style.opacity=unlocked?"1":".55";
    card.innerHTML=`
      <h3>${item.icon} ${item.name} ${unlocked?"✅":"🔒"}</h3>
      <p>${item.desc}</p>
      <span class="badge">${unlocked?"Desbloqueada":"Ainda bloqueada"}</span>`;
    container.appendChild(card);
  });
}

renderAll();
</script>
</body>
</html>
