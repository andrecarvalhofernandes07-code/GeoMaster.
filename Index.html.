      <div class="stat"><strong id="homeLevel">1</strong><small>Nível</small></div>
      <div class="stat"><strong id="homeWorlds">1</strong><small>Mundos</small></div>
      <div class="stat"><strong id="homeWins">0</strong><small>Fases vencidas</small></div>
    </div>
    <button class="btn" onclick="showPage('map')">🗺️ Explorar mundos</button>
    <button class="btn secondary" onclick="continueGame()">▶ Continuar aventura</button>
    <button class="btn secondary" onclick="showPage('heroes')">🥷 Escolher ninja</button>
    <button class="btn secondary" onclick="showPage('achievements')">🏆 Conquistas</button>
  </div>
  <h2>📜 Sua missão</h2>
  <div class="card"><p>Acerte pelo menos 7 das 10 perguntas de uma fase para ganhar XP e desbloquear a próxima.</p></div>
</section>

<section id="map" class="page">
  <h1>🗺️ Mundos</h1>
  <p>Escolha um mundo para explorar.</p>
  <div id="worldList" class="grid"></div>
  <button class="btn secondary" onclick="showPage('home')">← Voltar</button>
</section>

<section id="heroes" class="page">
  <h1>🥷 Escolha seu ninja</h1>
  <p>Desbloqueie personagens usando XP.</p>
  <div id="heroList" class="grid"></div>
  <button class="btn secondary" onclick="showPage('home')">← Voltar</button>
</section>

<section id="game" class="page">
  <button class="btn secondary" onclick="leaveGame()">✕ Sair da fase</button>
  <div class="question-card">
    <div class="meta"><span id="gameWorld"></span><span id="questionCount"></span></div>
    <div class="progress"><div id="questionProgress"></div></div>
    <div id="gameNinja" class="ninja" style="font-size:45px;text-align:center">🥷</div>
    <h2 id="questionText">Preparando pergunta...</h2>
    <div id="answers"></div>
    <p id="feedback" class="feedback" aria-live="polite"></p>
    <button id="nextBtn" class="btn" onclick="nextQuestion()" hidden>Próxima pergunta →</button>
  </div>
</section>

<section id="result" class="page">
  <div class="banner">
    <div id="resultIcon" class="ninja">🏆</div>
    <h1 id="resultTitle"></h1>
    <p id="resultText"></p>
    <div class="stats">
      <div class="stat"><strong id="resultScore">0/10</strong><small>Acertos</small></div>
      <div class="stat"><strong id="resultXP">0</strong><small>XP ganhos</small></div>
      <div class="stat"><strong id="resultLevel">1</strong><small>Nível</small></div>
    </div>
    <button id="resultMainBtn" class="btn" onclick="showPage('map')">Voltar aos mundos</button>
    <button class="btn secondary" onclick="showPage('home')">Início</button>
  </div>
</section>

<section id="achievements" class="page">
  <h1>🏆 Conquistas</h1>
  <div id="achievementList"></div>
  <button class="btn secondary" onclick="showPage('home')">← Voltar</button>
</section>
</main>

<footer>GeoMaster • Aprenda explorando o mundo 🌎</footer>

